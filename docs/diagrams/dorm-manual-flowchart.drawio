<mxfile host="app.diagrams.net"><diagram name="Current Manual Process"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" pageWidth="900" pageHeight="1180"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="180" height="50" as="geometry"/></mxCell><mxCell id="a1" value="Person arrives at dormitory entrance gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="105" width="280" height="60" as="geometry"/></mxCell><mxCell id="a2" value="Security guard stops person and verifies identity verbally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="200" width="280" height="65" as="geometry"/></mxCell><mxCell id="a3" value="Person declares status as Dorm Resident or Visitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="295" width="280" height="60" as="geometry"/></mxCell><mxCell id="d" value="Resident or Visitor?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5b86c4;strokeColor=#333;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="325" y="385" width="250" height="100" as="geometry"/></mxCell><mxCell id="b1" value="Resident presents physical dorm ID card or student ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="260" height="65" as="geometry"/></mxCell><mxCell id="b2" value="Guard manually flips through printed paper resident masterlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="260" height="65" as="geometry"/></mxCell><mxCell id="b3" value="Resident manually writes name, room number, date &amp;amp; time in logbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="65" as="geometry"/></mxCell><mxCell id="b4" value="Guard verifies signature and unlocks entrance gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="815" width="260" height="65" as="geometry"/></mxCell><mxCell id="b5" value="Resident enters building and proceeds to room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="260" height="60" as="geometry"/></mxCell><mxCell id="be" value="Completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1005" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1" value="Visitor states full name and name of host resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="530" width="260" height="65" as="geometry"/></mxCell><mxCell id="c2" value="Guard calls resident room phone or mobile to confirm invitation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="625" width="260" height="65" as="geometry"/></mxCell><mxCell id="c3" value="Visitor surrenders physical valid ID in exchange for paper visitor badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="720" width="260" height="65" as="geometry"/></mxCell><mxCell id="c4" value="Visitor writes details (name, contact, purpose, in-time) in visitor log" style="rounded=1;wh