<mxfile host="app.diagrams.net"><diagram name="Proposed Automated Process"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" pageWidth="960" pageHeight="1440"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="20" width="180" height="50" as="geometry"/></mxCell><mxCell id="p1" value="User logs into Dormitory Management System via Web / Mobile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="290" height="60" as="geometry"/></mxCell><mxCell id="p2" value="System verifies credentials and loads role dashboard (Admin, Guard, Resident)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="190" width="290" height="60" as="geometry"/></mxCell><mxCell id="p3" value="Person approaches dormitory security entrance gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="280" width="290" height="60" as="geometry"/></mxCell><mxCell id="p4" value="Security guard opens QR Scanner on guard device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="370" width="290" height="60" as="geometry"/></mxCell><mxCell id="p5" value="Guard selects access mode (Check-In or Check-Out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="460" width="290" height="60" as="geometry"/></mxCell><mxCell id="d" value="Scan Resident QR or Visitor Pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#5b86c4;strokeColor=#333;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="550" width="290" height="110" as="geometry"/></mxCell><mxCell id="res1" value="Resident presents personal digital QR Code from mobile portal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="700" width="270" height="65" as="geometry"/></mxCell><mxCell id="res2" value="Guard scans Resident QR code using device camera scanner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="795" width="270" height="65" as="geometry"/></mxCell><mxCell id="res3" value="System validates active resident account &amp;amp; room assignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="890" width="270" height="65" as="geometry"/></mxCell><mxCell id="res4" value="System creates AccessLog record with timestamp and guard ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="985" width="270" height="65" as="geometry"/></mxCell><mxCell id="res5" value="System displays resident photo, name and room on guard screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1080" width="270" height="65" as="geometry"/></mxCell><mxCell id="res6" value="Gate access granted; resident proceeds into / out of dormitory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25" y="1175" width="270" height="65" as="geometry"/></mxCell><mxCell id="rese" value="Completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1270" width="180" height="50" as="geometry"/></mxCell><mxCell id="vis1" value="Host resident pre-registers visitor online (name, purpose, date)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="700" width="270" height="65" as="geometry"/></mxCell><mxCell id="vis2" value="System generates digital Visitor QR pass with expiration timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="795" width="270" height="65" as="geometry"/></mxCell><mxCell id="vis3" value="Visitor arrives at gate and presents digital Visitor QR pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="890" width="270" height="65" as="geometry"/></mxCell><mxCell id="vis4" value="Guard scans QR pass; system checks validity, expiration &amp;amp; host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="985" width="270" height="65" as="geometry"/></mxCell><mxCell id="vis5" value="System records Visitor Check-In in AccessLog &amp;amp; notifies host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="1080" width="270" height="65" as="geometry"/></mxCell><mxCell id="vis6" value="Guard admits visitor; system initiates visitor duration monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2b3;strokeColor=#333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="615" y="1175" width="270" height="65" as="geometry"/></mxCell><mxCell id="vise" value="Completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#99e6dc;strokeColor=#333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="1270" width="180" height="50" as="geometry"/></mxCell><mxCell id="ed1" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;" edge="1"