<mxfile host="app.diagrams.net"><diagram name="Dormitory Use Case Diagram - RBAC Modules"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" pageWidth="1200" pageHeight="950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;USE CASE DIAGRAM — DORMITORY SYSTEM MODULES &amp;amp; RBAC&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="650" height="30" as="geometry"/></mxCell><mxCell id="sys_boundary" value="Dormitory Management System (Role-Based Access Control)" style="rounded=1;arcSize=4;fillColor=#f8fafd;strokeColor=#8ea0b5;strokeWidth=2.5;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#2d3748;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="480" height="780" as="geometry"/></mxCell><mxCell id="actor_admin" value="Administrator&lt;br&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(Web Portal)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#2f4052;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="440" width="70" height="130" as="geometry"/></mxCell><mxCell id="actor_res" value="Resident&lt;br&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(Web / Mobile)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#2f4052;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="70" height="130" as="geometry"/></mxCell><mxCell id="actor_guard" value="Security Guard&lt;br&gt;&lt;i style=&quot;font-size:10px;&quot;&gt;(Mobile Scanner)&lt;/i&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#2f4052;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="420" width="70" height="130" as="geometry"/></mxCell><mxCell id="m1" value="Authentication &amp;amp; Session Module&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:normal;color:#555;&quot;&gt;JWT Login, Password Hashing &amp;amp; RBAC Route Guard&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef8f8;strokeColor=#1e6b7b;strokeWidth=2;fontSize=11.5;fontStyle=1;fontColor=#1b3a4b;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="400" height="55" as="geometry"/></mxCell><mxCell id="m2" value="Resident Profile &amp;amp; Personal QR Pass Module&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:normal;color:#555;&quot;&gt;Profile View, Room Info &amp;amp; Unique Digital QR Token&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef8f8;strokeColor=#1e6b7b;strokeWidth=2;fontSize=11.5;fontStyle=1;fontColor=#1b3a4b;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="400" height="55" as="geometry"/></mxCell><mxCell id="m3" value="Visitor Request &amp;amp; Pass Management Module&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:normal;color:#555;&quot;&gt;Invitation Request, 24h Expiry QR Pass &amp;amp; Status&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef8f8;strokeColor=#1e6b7b;strokeWidth=2;fontSize=11.5;fontStyle=1;fontColor=#1b3a4b;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="400" height="55" as="geometry"/></mxCell><mxCell id="m4" value="QR Scanner &amp;amp; Gate Verification Module&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:normal;color:#555;&quot;&gt;Camera Scan, Check-In/Out Validation &amp;amp; Identity Check&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef8f8;strokeColor=#1e6b7b;strokeWidth=2;fontSize=11.5;fontStyle=1;fontColor=#1b3a4b;" vertex="1" parent="1"><mxGeometry x="400" y="350" width="400" height="55" as="geometry"/></mxCell><mxCell id="m5" value="Gate Access Logs &amp;amp; Audit Module&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:normal;color:#55